# Helal Media Production — Environment Configuration
# Copy this file to .env.local and supply genuine credentials to enable live email delivery.

# Destination inbox for inquiries (must receive all contact form submissions)
CONTACT_RECEIVER_EMAIL=helal.media0@gmail.com

# OPTION 1: Gmail SMTP Setup (Recommended for helal.media0@gmail.com)
# Generate an App Password in your Google Account:
# 1. Enable 2-Step Verification at https://myaccount.google.com/security
# 2. Go to "App passwords" (https://myaccount.google.com/apppasswords)
# 3. Create an app named "Helal Media Website"
# 4. Copy the 16-character password and paste below:
GMAIL_USER=helal.media0@gmail.com
GMAIL_APP_PASSWORD=

# OPTION 2: Custom / Enterprise SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL="Helal Media Website" <helal.media0@gmail.com>

# OPTION 3: Resend / Transactional API
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# OPTION 4: Webhook / CRM Endpoint
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Official Base URL
NEXT_PUBLIC_SITE_URL=https://helalmedia.com


